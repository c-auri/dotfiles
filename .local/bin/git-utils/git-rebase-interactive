#!/bin/bash

# Interactively rebases commits back to a given depth or the merge-base with the default branch

source "$HOME/.local/bin/git-utils/git-lib"
require_git_repo

if [[ -n $1 ]]
then
    base="HEAD~$1"
else
    # prefer the remote tracking ref; without a remote the local default branch
    # is the only truth available, though that makes this a no-op while on it
    default="$(get_default_branch upstream)"
    default="${default:-$(get_default_branch)}"

    if [[ -z "$default" ]]
    then
        echo "error: could not determine the default branch" >&2
        exit 1
    fi

    base="$(git merge-base HEAD "$default")"
fi

git rebase --interactive --autosquash "$base"
