#!/bin/bash

# shared library sourced by custom git commands, not meant to be invoked directly

function require_git_repo
{
    # fail fast and once, rather than letting every subsequent git call in
    # the caller fail separately with its own copy of the same error
    local err
    err=$(git rev-parse --git-dir 2>&1 >/dev/null)
    if [[ -n $err ]]
    then
        echo "$err" >&2
        exit 1
    fi
}

function get_remote
{
    # if the repo has more than one remote, this is inaccurate
    # I'll fix it if that ever happens to me ¯\_(ツ)_/¯
    git remote | head -1
}

function get_default_branch {
    local ref
    ref=$(git symbolic-ref --short "refs/remotes/$(get_remote)/HEAD")
    [[ "$1" == "upstream" ]] && echo $ref || echo ${ref##*/}
}

function get_changed_files
{
    # NUL-terminated paths from `git status`, one per changed file.
    # Safe for filenames containing spaces or quotes,
    # unlike parsing plain `git status` output with text tools.
    # For a rename/copy, only the new path is listed.
    git status --porcelain=v1 -z |
        while IFS= read -r -d '' entry
        do
            printf '%s\0' "${entry:3}"
            [[ "${entry:0:2}" == *[RC]* ]] && read -r -d '' _  # discard old path
        done
}

function get_branch_range
{
    # revision range covering the commits that belong to the current branch,
    # for commands that operate on "my commits" rather than all history.
    # $1: optional commit count, overrides the merge-base default
    local merge_base count

    count=$(git rev-list --count HEAD)

    # a base..HEAD range excludes the base, so reaching back to or past the root
    # commit has to be expressed as plain HEAD, or the initial commit is dropped
    if [[ -n $1 ]]
    then
        (( $1 >= count )) && echo HEAD || echo "HEAD~$1..HEAD"
        return
    fi

    # compare against the remote tracking branch, not the local one; using the local branch
    # name would make merge-base equal HEAD whenever we're on the default branch, even when
    # there are unpushed commits worth targeting
    merge_base="$(git merge-base HEAD "$(get_default_branch upstream 2>/dev/null)" 2>/dev/null)"

    if [[ -z "$merge_base" || "$merge_base" == "$(git rev-parse HEAD)" ]]
    then
        (( count <= 10 )) && echo HEAD || echo "HEAD~10..HEAD"
    else
        echo "$merge_base..HEAD"
    fi
}
