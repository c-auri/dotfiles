#!/bin/bash

# shared library sourced by custom git commands, not meant to be invoked directly

function require_git_repo
{
    # fail fast and once, rather than letting every subsequent git call in
    # the caller fail separately with its own copy of the same error
    local err
    err=$(git rev-parse --git-dir 2>&1 >/dev/null)
    if [[ -n $err ]]
    then
        echo "$err" >&2
        exit 1
    fi
}

function get_remote
{
    # if the repo has more than one remote, this is inaccurate
    # I'll fix it if that ever happens to me ¯\_(ツ)_/¯
    git remote | head -1
}

function require_remote
{
    # fail fast and once with an actionable message, rather than letting the
    # caller pass an empty ref into git and get a confusing error back.
    # verifies the <remote>/HEAD symref too, since that's what identifies
    # which branch is the default one
    local remote
    remote="$(get_remote)"

    if [[ -z "$remote" ]]
    then
        echo "error: no remote configured" >&2
        exit 1
    fi

    if ! git symbolic-ref --quiet "refs/remotes/$remote/HEAD" >/dev/null
    then
        echo "error: $remote/HEAD is not set, run: git remote set-head $remote -a" >&2
        exit 1
    fi
}

function get_default_branch
{
    # quiet, with a non-zero status when there's no answer -- callers that talk
    # to the remote should call require_remote first, those that only need the
    # name can rely on the local fallback, those that can do without should
    # test the result for emptiness
    # $1: "upstream" for the remote tracking ref, otherwise the short name
    local remote ref name

    remote="$(get_remote)"
    [[ -n "$remote" ]] && ref=$(git symbolic-ref --short "refs/remotes/$remote/HEAD" 2>/dev/null)

    if [[ -n "$ref" ]]
    then
        [[ "$1" == "upstream" ]] && echo "$ref" || echo "${ref##*/}"
        return
    fi

    # no remote, or no <remote>/HEAD symref: there's no upstream ref to name,
    # but the local default branch is still discoverable by convention
    [[ "$1" == "upstream" ]] && return 1

    for name in main master
    do
        git rev-parse --verify --quiet "refs/heads/$name" >/dev/null && echo "$name" && return
    done

    return 1
}

function print_graph_window
{
    # prints a fixed-size window of the combined graph for $1 and $2,
    # centered on $1's line, with an up/down indicator when $2 falls
    # outside the window
    # $1: primary ref, the window centers on this ref's line
    # $2: secondary ref, reported via the indicator if out of view
    #     (pass "" to omit the indicator/secondary ref entirely)
    # $3: window half-size -- lines shown above and below the primary ref
    local primary="$1" secondary="$2" n="$3"
    local primary_hash secondary_hash secondary_msg ref_display ahead behind script_dir
    local refs=("$primary")

    primary_hash="$(git rev-parse --short "$primary" 2>/dev/null)"

    secondary_hash=""
    if [[ -n "$secondary" ]]
    then
        secondary_hash="$(git rev-parse --short "$secondary" 2>/dev/null)"
        refs+=("$secondary")
    fi

    secondary_msg=""
    if [[ -n "$secondary_hash" && "$secondary_hash" != "$primary_hash" ]]
    then
        read -r ahead behind < <(git rev-list --left-right --count "$primary...$secondary")

        # bold red, matching git log --decorate's color.decorate.remoteBranch default
        ref_display=$'\033[1;31m'"$secondary"$'\033[m'

        if (( behind == 0 ))
        then
            secondary_msg="$ref_display [ahead $ahead]"
        elif (( ahead == 0 ))
        then
            secondary_msg="$ref_display [behind $behind]"
        else
            secondary_msg="$ref_display [ahead $ahead, behind $behind]"
        fi
    fi

    script_dir="$(dirname "${BASH_SOURCE[0]}")"

    git log --graph --oneline --decorate --color=always "${refs[@]}" |
        awk -f "$script_dir/extract-graph-window.awk" \
            -v hash="$primary_hash" -v dhash="$secondary_hash" -v msg="$secondary_msg" -v n="$n"
}

function get_changed_files
{
    # NUL-terminated paths from `git status`, one per changed file.
    # Safe for filenames containing spaces or quotes,
    # unlike parsing plain `git status` output with text tools.
    # For a rename/copy, only the new path is listed.
    git status --porcelain=v1 -z |
        while IFS= read -r -d '' entry
        do
            printf '%s\0' "${entry:3}"
            if [[ "${entry:0:2}" == *[RC]* ]]
            then
                read -r -d '' _  # discard old path
            fi
        done
    true  # the loop's own exit status reflects its last entry, not success
}

function get_branch_range
{
    # revision range covering the commits that belong to the current branch,
    # for commands that operate on "my commits" rather than all history.
    # $1: optional commit count, overrides the merge-base default
    local merge_base count

    count=$(git rev-list --count HEAD)

    # a base..HEAD range excludes the base, so reaching back to or past the root
    # commit has to be expressed as plain HEAD, or the initial commit is dropped
    if [[ -n $1 ]]
    then
        (( $1 >= count )) && echo HEAD || echo "HEAD~$1..HEAD"
        return
    fi

    # compare against the remote tracking branch, not the local one; using the local branch
    # name would make merge-base equal HEAD whenever we're on the default branch, even when
    # there are unpushed commits worth targeting
    merge_base="$(git merge-base HEAD "$(get_default_branch upstream)" 2>/dev/null)"

    if [[ -z "$merge_base" || "$merge_base" == "$(git rev-parse HEAD)" ]]
    then
        (( count <= 10 )) && echo HEAD || echo "HEAD~10..HEAD"
    else
        echo "$merge_base..HEAD"
    fi
}
