#!/bin/bash

# Shows a window of the commit graph centered on the current branch

source "$HOME/.local/bin/git-utils/git-lib"
require_git_repo

if ! git rev-parse --verify --quiet HEAD > /dev/null
then
    echo "No commits yet."
    exit 0
fi

if [[ "$1" == "-a" ]]
then
    git log --graph --oneline --all
    exit 0
fi

n="${1:-10}"

if ! [[ "$n" =~ ^[1-9][0-9]*$ ]]
then
    echo "error: expected a positive integer or -a, got '$n'" >&2
    exit 1
fi

default_ref="$(get_default_branch upstream)"

print_graph_window HEAD "$default_ref" "$n"
