#!/bin/bash

# Shows a compact graph of recent commits across all branches

source "$HOME/.local/bin/git-utils/git-lib"
require_git_repo

if ! git rev-parse --verify --quiet HEAD > /dev/null
then
    echo "No commits yet."
    exit 0
fi

if [[ "$1" == "-a" ]]
then
    git log --graph --oneline --all
    exit 0
fi

count="${1:-10}"

if ! [[ "$count" =~ ^[1-9][0-9]*$ ]]
then
    echo "error: expected a positive integer or -a, got '$count'" >&2
    exit 1
fi

git log --graph --oneline --all -"$count"
